{
  "expo": {
    "name": "RN Chatbot Camera",
    "slug": "rn-chatbot-camera",
    "version": "1.0.0",
    "scheme": "rn-chatbot-camera",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.rnchatbotcamera",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.rnchatbotcamera",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "Study Companion",
      "shortName": "Companion",
      "themeColor": "#2563eb",
      "backgroundColor": "#f4f6f8",
      "display": "standalone",
      "lang": "en",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to capture photos in chat."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fcc30caa-2ada-4282-82dc-424c14cf436e"
      }
    },
    "owner": "canuk"
  }
}
